<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- Video Output Views -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="true"
        app:show_timeout="3000"
        android:focusable="true" />

    <SurfaceView
        android:id="@+id/displaySurfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Simple Home Screen Flow (Default when no video is playing) -->
    <LinearLayout
        android:id="@+id/layoutHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:background="#E0101010">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RIFE &amp; FastDVDnet TV Player"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnOpenVideo"
            android:layout_width="280dp"
            android:layout_height="50dp"
            android:text="Open Video File"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/selector_tv_button"
            android:focusable="true"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnHomeSettings"
            android:layout_width="280dp"
            android:layout_height="50dp"
            android:text="Settings"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/selector_tv_button"
            android:focusable="true"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnRunDiagnostic"
            android:layout_width="280dp"
            android:layout_height="50dp"
            android:text="System Diagnostics"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/selector_tv_button"
            android:focusable="true" />
    </LinearLayout>

    <!-- Overlay Diagnostic & Statistics HUD -->
    <TextView
        android:id="@+id/tvOverlayStats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="20dp"
        android:padding="12dp"
        android:background="#D0000000"
        android:textColor="#00E676"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:visibility="gone"
        android:text="Status: Ready" />

    <!-- Lightweight Seek Indicator HUD -->
    <TextView
        android:id="@+id/tvSeekFeedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#D0000000"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone" />

    <!-- Side-Panel TV Settings Overlay -->
    <ScrollView
        android:id="@+id/layoutSettingsOverlay"
        android:layout_width="380dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#F0121212"
        android:padding="20dp"
        android:visibility="gone"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Player Settings"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- RIFE Switch -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="RIFE Frame Interpolation"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <Switch
                    android:id="@+id/switchRife"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OFF"
                    android:textColor="#00E676"
                    android:focusable="true" />
            </LinearLayout>

            <!-- FastDVDnet Switch -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="FastDVDnet Denoising"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <Switch
                    android:id="@+id/switchFastDvdNet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OFF"
                    android:textColor="#00E676"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Resolution Quality -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Processing Quality"
                android:textColor="#00E676"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinnerResolution"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:focusable="true"
                android:background="@drawable/selector_tv_button"
                android:layout_marginBottom="16dp" />

            <!-- External Tracks & Sync -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Audio &amp; Subtitle Options"
                android:textColor="#00E676"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <Button
                android:id="@+id/btnExtAudio"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="Attach External Audio"
                android:textColor="#FFFFFF"
                android:background="@drawable/selector_tv_button"
                android:focusable="true"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnExtSub"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="Attach External Subtitle"
                android:textColor="#FFFFFF"
                android:background="@drawable/selector_tv_button"
                android:focusable="true"
                android:layout_marginBottom="12dp" />

            <!-- Audio Delay Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tvAudioDelay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Audio Delay: 0ms"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnAudioDelayMinus"
                    android:layout_width="50dp"
                    android:layout_height="36dp"
                    android:text="-0.5s"
                    android:textSize="10sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/selector_tv_button"
                    android:focusable="true"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnAudioDelayPlus"
                    android:layout_width="50dp"
                    android:layout_height="36dp"
                    android:text="+0.5s"
                    android:textSize="10sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/selector_tv_button"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Subtitle Delay Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvSubDelay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Subtitle Delay: 0ms"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnSubDelayMinus"
                    android:layout_width="50dp"
                    android:layout_height="36dp"
                    android:text="-0.5s"
                    android:textSize="10sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/selector_tv_button"
                    android:focusable="true"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnSubDelayPlus"
                    android:layout_width="50dp"
                    android:layout_height="36dp"
                    android:text="+0.5s"
                    android:textSize="10sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/selector_tv_button"
                    android:focusable="true" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSettingsDiagnostics"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="System Diagnostics"
                android:textColor="#FFFFFF"
                android:background="@drawable/selector_tv_button"
                android:focusable="true"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnCloseSettings"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="Close Settings"
                android:textColor="#FFFFFF"
                android:background="@drawable/selector_tv_button"
                android:focusable="true" />
        </LinearLayout>
    </ScrollView>

    <!-- Diagnostic Log Dialog Overlay -->
    <ScrollView
        android:id="@+id/layoutDiagnosticDialog"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F0101010"
        android:padding="24dp"
        android:visibility="gone"
        android:elevation="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RIFE &amp; Vulkan System Diagnostics"
                android:textColor="#00E676"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvDiagnosticDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/btnCloseDiagnostic"
                android:layout_width="200dp"
                android:layout_height="40dp"
                android:text="Close Diagnostics"
                android:textColor="#FFFFFF"
                android:background="@drawable/selector_tv_button"
                android:focusable="true" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
