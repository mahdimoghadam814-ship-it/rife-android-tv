<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- Video Output Views -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        android:focusable="false" />

    <SurfaceView
        android:id="@+id/displaySurfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- In-App USB / Local Video Media Browser -->
    <LinearLayout
        android:id="@+id/layoutFilePicker"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F00A0A0A"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="RIFE Android TV - Local Videos"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSystemFilePicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System File Picker"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/selector_tv_button"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:focusable="true"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/btnRunDiagnostic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Diagnostics"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/selector_tv_button"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:focusable="true" />
        </LinearLayout>

        <GridView
            android:id="@+id/gridVideos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:numColumns="4"
            android:horizontalSpacing="16dp"
            android:verticalSpacing="16dp"
            android:stretchMode="columnWidth"
            android:focusable="true"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />
    </LinearLayout>

    <!-- Overlay Diagnostic & Statistics HUD -->
    <TextView
        android:id="@+id/tvOverlayStats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="20dp"
        android:padding="12dp"
        android:background="#D0000000"
        android:textColor="#00E676"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:visibility="gone"
        android:text="RIFE Status: Ready" />

    <!-- Lightweight Seek Indicator HUD -->
    <TextView
        android:id="@+id/tvSeekFeedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#D0000000"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone" />

    <!-- On-Screen TV Player Controls Overlay -->
    <LinearLayout
        android:id="@+id/layoutPlayerControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#E6101010"
        android:padding="20dp"
        android:visibility="gone">

        <!-- Position / Duration Text & Seekbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="monospace" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:focusable="true"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Control Buttons Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnRewind"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="-10s"
                android:textColor="#FFFFFF"
                android:background="@drawable/selector_tv_button"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:focusable="true"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnPlayPause"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Pause"
                android:textColor="#FFFFFF"
                android:background="@drawable/selector_tv_button"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:focusable="true"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnForward"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="+10s"
                android:textColor="#FFFFFF"
                android:background="@drawable/selector_tv_button"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:focusable="true"
                android:layout_marginEnd="16dp" />

            <Button
                android:id="@+id/btnAudioTracks"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Audio Tracks"
                android:textColor="#FFFFFF"
                android:background="@drawable/selector_tv_button"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:focusable="true"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnSubtitleTracks"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Subtitles"
                android:textColor="#FFFFFF"
                android:background="@drawable/selector_tv_button"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:focusable="true"
                android:layout_marginEnd="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RIFE:"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginEnd="6dp" />

            <Switch
                android:id="@+id/switchRife"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OFF"
                android:textColor="#00E676"
                android:focusable="true"
                android:layout_marginEnd="16dp" />

            <Button
                android:id="@+id/btnOpenSettings"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Settings"
                android:textColor="#FFFFFF"
                android:background="@drawable/selector_tv_button"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:focusable="true" />
        </LinearLayout>

        <!-- Media & Synchronization Controls Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnExtAudio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ext Audio"
                android:textSize="12sp"
                android:focusable="true"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnAudioDelayMinus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A -0.5s"
                android:textSize="12sp"
                android:focusable="true"
                android:layout_marginEnd="2dp" />

            <TextView
                android:id="@+id/tvAudioDelay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A: 0ms"
                android:textColor="#FFEB3B"
                android:textSize="12sp"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/btnAudioDelayPlus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A +0.5s"
                android:textSize="12sp"
                android:focusable="true"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/btnExtSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ext Sub"
                android:textSize="12sp"
                android:focusable="true"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnSubDelayMinus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S -0.5s"
                android:textSize="12sp"
                android:focusable="true"
                android:layout_marginEnd="2dp" />

            <TextView
                android:id="@+id/tvSubDelay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S: 0ms"
                android:textColor="#FFEB3B"
                android:textSize="12sp"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/btnSubDelayPlus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S +0.5s"
                android:textSize="12sp"
                android:focusable="true" />
        </LinearLayout>

    </LinearLayout>

    <!-- Side-Panel TV Settings Overlay -->
    <LinearLayout
        android:id="@+id/layoutSettingsOverlay"
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#F0121212"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone"
        android:elevation="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RIFE Resolution Mode"
            android:textColor="#00E676"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerResolution"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:focusable="true"
            android:background="@drawable/selector_tv_button"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Audio Track"
            android:textColor="#00E676"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/btnSettingsAudioTrack"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Select Audio Track"
            android:textColor="#FFFFFF"
            android:background="@drawable/selector_tv_button"
            android:focusable="true"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Subtitle Track"
            android:textColor="#00E676"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/btnSettingsSubtitleTrack"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Select Subtitle Track"
            android:textColor="#FFFFFF"
            android:background="@drawable/selector_tv_button"
            android:focusable="true"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnSettingsDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="System Diagnostics"
            android:textColor="#FFFFFF"
            android:background="@drawable/selector_tv_button"
            android:focusable="true"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnCloseSettings"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Close Settings"
            android:textColor="#FFFFFF"
            android:background="@drawable/selector_tv_button"
            android:focusable="true" />
    </LinearLayout>

    <!-- Diagnostic Log Dialog Overlay -->
    <ScrollView
        android:id="@+id/layoutDiagnosticDialog"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F0101010"
        android:padding="24dp"
        android:visibility="gone"
        android:elevation="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RIFE &amp; Vulkan System Diagnostics"
                android:textColor="#00E676"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvDiagnosticDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/btnCloseDiagnostic"
                android:layout_width="200dp"
                android:layout_height="40dp"
                android:text="Close Diagnostics"
                android:textColor="#FFFFFF"
                android:background="@drawable/selector_tv_button"
                android:focusable="true" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
