<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- Normal ExoPlayer Output View -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true" />

    <!-- Interpolated / Intercepted Video Surface -->
    <SurfaceView
        android:id="@+id/displaySurfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Main Home Screen Overlay (Simple File Picker Model) -->
    <LinearLayout
        android:id="@+id/layoutFilePicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="36dp"
        android:background="#E0101010">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RIFE Android TV Player"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnOpenVideo"
            android:layout_width="280dp"
            android:layout_height="60dp"
            android:text="Open Video File"
            android:textSize="20sp"
            android:textStyle="bold"
            android:focusable="true"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnRunDiagnostic"
            android:layout_width="280dp"
            android:layout_height="50dp"
            android:text="System Diagnostics"
            android:textSize="16sp"
            android:focusable="true" />
    </LinearLayout>

    <!-- On-Screen Seek Feedback Overlay -->
    <TextView
        android:id="@+id/tvSeekFeedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="16dp"
        android:background="#C0000000"
        android:textColor="#00E676"
        android:textSize="36sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- On-Screen TV Player Controls Overlay -->
    <LinearLayout
        android:id="@+id/layoutPlayerControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#E0101010"
        android:padding="20dp"
        android:visibility="gone">

        <!-- Position / Duration Seek Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="monospace" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:focusable="true"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Player Controls Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnRewind"
                android:layout_width="100dp"
                android:layout_height="50dp"
                android:text="-10s"
                android:textSize="16sp"
                android:focusable="true"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/btnPlayPause"
                android:layout_width="120dp"
                android:layout_height="50dp"
                android:text="Pause"
                android:textSize="18sp"
                android:textStyle="bold"
                android:focusable="true"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/btnForward"
                android:layout_width="100dp"
                android:layout_height="50dp"
                android:text="+10s"
                android:textSize="16sp"
                android:focusable="true"
                android:layout_marginEnd="24dp" />

            <Button
                android:id="@+id/btnOpenSettings"
                android:layout_width="140dp"
                android:layout_height="50dp"
                android:text="Settings"
                android:textSize="16sp"
                android:textStyle="bold"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Dedicated Application Settings TV Overlay Panel -->
    <ScrollView
        android:id="@+id/layoutSettingsOverlay"
        android:layout_width="380dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#F0151515"
        android:padding="24dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Player Settings"
                android:textColor="#00E676"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp" />

            <!-- RIFE Settings Group -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RIFE Frame Interpolation"
                android:textColor="#FFEB3B"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Enable RIFE:"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <Switch
                    android:id="@+id/switchRife"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OFF"
                    android:textColor="#00E676"
                    android:focusable="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Processing Quality:"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <Spinner
                    android:id="@+id/spinnerResolution"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Audio Settings Group -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Audio Sync &amp; Tracks"
                android:textColor="#FFEB3B"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnExtAudio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Attach External Audio File"
                android:textSize="14sp"
                android:focusable="true"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnSettingsAudioTrack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select Audio Track"
                android:textSize="14sp"
                android:focusable="true"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <Button
                    android:id="@+id/btnAudioDelayMinus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="-0.5s"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tvAudioDelay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A: 0ms"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

                <Button
                    android:id="@+id/btnAudioDelayPlus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="+0.5s"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Subtitle Settings Group -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subtitle Sync &amp; Tracks"
                android:textColor="#FFEB3B"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnExtSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Attach External Subtitle File"
                android:textSize="14sp"
                android:focusable="true"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnSettingsSubtitleTrack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select Subtitle Track"
                android:textSize="14sp"
                android:focusable="true"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <Button
                    android:id="@+id/btnSubDelayMinus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="-0.5s"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tvSubDelay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="S: 0ms"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

                <Button
                    android:id="@+id/btnSubDelayPlus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="+0.5s"
                    android:focusable="true" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSettingsDiagnostics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="System Diagnostics"
                android:textSize="14sp"
                android:focusable="true"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnCloseSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Close Settings"
                android:textSize="16sp"
                android:textStyle="bold"
                android:focusable="true" />
        </LinearLayout>
    </ScrollView>

    <!-- Overlay Diagnostic & Statistics HUD -->
    <TextView
        android:id="@+id/tvOverlayStats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:padding="8dp"
        android:background="#C0000000"
        android:textColor="#00E676"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:text="RIFE Status: Ready" />

    <!-- Diagnostic Log Dialog / Sheet Overlay -->
    <ScrollView
        android:id="@+id/layoutDiagnosticDialog"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F0101010"
        android:padding="24dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RIFE &amp; Vulkan System Diagnostics"
                android:textColor="#00E676"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvDiagnosticDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/btnCloseDiagnostic"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:text="Close Diagnostics"
                android:focusable="true" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
