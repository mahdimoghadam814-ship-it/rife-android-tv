<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212">

    <!-- Top Header & Player Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1E1E1E"
        android:padding="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Just Player + Real RIFE Vulkan Engine"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnOpenVideo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open Video"
            android:focusable="true"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnPlayPause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Play"
            android:focusable="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left: Video Output Area -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:background="#000000">

            <androidx.media3.ui.PlayerView
                android:id="@+id/playerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:focusable="true" />

            <TextureView
                android:id="@+id/textureView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <!-- Diagnostic Overlay -->
            <TextView
                android:id="@+id/tvDiagnosticOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:padding="8dp"
                android:background="#B0000000"
                android:textColor="#00E676"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:text="Video: None\nInput FPS: 0\nOutput FPS: 0\nRIFE: OFF\nProcessing: 0 ms\nDropped: 0" />
        </FrameLayout>

        <!-- Right: TV Settings & Controls -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#1A1A1A"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RIFE Settings"
                    android:textColor="#00E676"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- RIFE Toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="RIFE Interpolation:"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <Switch
                        android:id="@+id/switchRife"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OFF"
                        android:textColor="#B0BEC5"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Processing Resolution -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Processing Resolution:"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp" />

                <RadioGroup
                    android:id="@+id/rgResolution"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <RadioButton
                        android:id="@+id/rbOriginal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Original Resolution"
                        android:checked="true"
                        android:textColor="#FFFFFF"
                        android:focusable="true" />

                    <RadioButton
                        android:id="@+id/rb720p"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="720p (Downscale to 1280)"
                        android:textColor="#FFFFFF"
                        android:focusable="true" />

                    <RadioButton
                        android:id="@+id/rb480p"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="480p (Downscale to 854)"
                        android:textColor="#FFFFFF"
                        android:focusable="true" />
                </RadioGroup>

                <Button
                    android:id="@+id/btnRunRifeTest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Run RIFE GPU Test (256x256)"
                    android:focusable="true"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/tvDiagnosticLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="System Status: Ready"
                    android:textColor="#CCCCCC"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
