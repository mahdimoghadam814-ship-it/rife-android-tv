     ncnn_add_shader(${CMAKE_CURRENT_SOURCE_DIR}/ncnn_glsl_ext.comp)
+    # Precompile shaders that crash glslang on Adreno 825 / Mali-G310
+    ncnn_add_shader(${CMAKE_CURRENT_SOURCE_DIR}/layer/vulkan/shader/interp.comp)
+    ncnn_add_shader(${CMAKE_CURRENT_SOURCE_DIR}/layer/vulkan/shader/interp_pack4.comp)
