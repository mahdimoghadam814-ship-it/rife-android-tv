diff --git a/cmake/ncnn_add_shader.cmake b/cmake/ncnn_add_shader.cmake
index e41d1be6..6fccc900 100644
--- a/cmake/ncnn_add_shader.cmake
+++ b/cmake/ncnn_add_shader.cmake
@@ -2,6 +2,7 @@
 macro(ncnn_add_shader NCNN_SHADER_SRC)
     get_filename_component(NCNN_SHADER_SRC_NAME_WE ${NCNN_SHADER_SRC} NAME_WE)
     set(NCNN_SHADER_COMP_HEADER ${CMAKE_CURRENT_BINARY_DIR}/layer/vulkan/shader/${NCNN_SHADER_SRC_NAME_WE}.comp.hex.h)
+    set(NCNN_SHADER_SPV_HEADER ${CMAKE_CURRENT_BINARY_DIR}/layer/vulkan/shader/${NCNN_SHADER_SRC_NAME_WE}.comp.spv.h)
 
     add_custom_command(
         OUTPUT ${NCNN_SHADER_COMP_HEADER}
@@ -12,11 +13,29 @@ macro(ncnn_add_shader NCNN_SHADER_SRC)
     )
     set_source_files_properties(${NCNN_SHADER_COMP_HEADER} PROPERTIES GENERATED TRUE)
 
+    # Generate SPIR-V header for precompiled SPIR-V
+    add_custom_command(
+        OUTPUT ${NCNN_SHADER_SPV_HEADER}
+        COMMAND ${CMAKE_COMMAND}
+            -DSHADER_SRC=${NCNN_SHADER_SRC}
+            -DSHADER_SPV_HEADER=${NCNN_SHADER_SPV_HEADER}
+            -DNCNN_DIR=${CMAKE_CURRENT_SOURCE_DIR}/..
+            -DSHADER_REQUIRED=ON
+            -P "${CMAKE_CURRENT_SOURCE_DIR}/../../../app/src/main/cpp/cmake/precompile_spirv.cmake"
+        DEPENDS ${NCNN_SHADER_SRC} "${CMAKE_CURRENT_SOURCE_DIR}/../../../app/src/main/cpp/cmake/precompile_spirv.cmake" "${CMAKE_CURRENT_SOURCE_DIR}/../ncnn_glsl_ext.comp"
+        COMMENT "Precompiling shader ${NCNN_SHADER_SRC_NAME_WE}.comp to SPIR-V"
+        VERBATIM
+        ENVIRONMENT PATH=/usr/bin:/usr/local/bin:$ENV{PATH}
+    )
+    set_source_files_properties(${NCNN_SHADER_COMP_HEADER} ${NCNN_SHADER_SPV_HEADER} PROPERTIES GENERATED TRUE)
+
     get_filename_component(NCNN_SHADER_COMP_HEADER_NAME ${NCNN_SHADER_COMP_HEADER} NAME)
     string(APPEND layer_shader_spv_data "#include \"layer/vulkan/shader/${NCNN_SHADER_COMP_HEADER_NAME}\"\n")
+    get_filename_component(NCNN_SHADER_SPV_HEADER_NAME ${NCNN_SHADER_SPV_HEADER} NAME)
+    string(APPEND layer_shader_spv_data "#include \"layer/vulkan/shader/${NCNN_SHADER_SPV_HEADER_NAME}\"\n")
 
     get_filename_component(NCNN_SHADER_SRC_NAME_WE ${NCNN_SHADER_SRC} NAME_WE)
-    string(APPEND layer_shader_registry "{${NCNN_SHADER_SRC_NAME_WE}_comp_data,sizeof(${NCNN_SHADER_SRC_NAME_WE}_comp_data)},\n")
+    string(APPEND layer_shader_registry "{${NCNN_SHADER_SRC_NAME_WE}_spv_data,${NCNN_SHADER_SRC_NAME_WE}_spv_data_size},\n")
 
     if(NCNN_COVERAGE)
         # prefix sums use the original files and are shared by all shader variants
@@ -36,6 +55,7 @@ macro(ncnn_add_shader NCNN_SHADER_SRC)
     endif()
 
     list(APPEND NCNN_SHADER_SPV_HEX_FILES ${NCNN_SHADER_COMP_HEADER})
+    list(APPEND NCNN_SHADER_SPV_FILES ${NCNN_SHADER_SPV_HEADER})
 
     # generate layer_shader_type_enum file
     set(layer_shader_type_enum "${layer_shader_type_enum}${NCNN_SHADER_SRC_NAME_WE} = ${__LAYER_SHADER_TYPE_ENUM_INDEX},\n")
diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
